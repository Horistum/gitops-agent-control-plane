{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gitops-agent-control-plane/goal.schema.json",
  "title": "Engineering Goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "objective", "items", "risk_ceiling", "auto_merge_ceiling", "success_condition", "forbidden_directions"],
  "properties": {
    "schema": {"const": 1},
    "objective": {"type": "string", "minLength": 1},
    "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk_ceiling": {"enum": ["low", "medium", "high"]},
    "auto_merge_ceiling": {"enum": ["none", "low", "medium"]},
    "success_condition": {"type": "string", "minLength": 1},
    "forbidden_directions": {"type": "string", "minLength": 1}
  }
}
