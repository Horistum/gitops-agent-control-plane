include LICENSE NOTICE TRADEMARKS.md *.md pyproject.toml MANIFEST.in .gitignore
include requirements*.txt
include CONTROL-CORE.lock.json PORTABLE-ORIGINS.json
recursive-include control_plane_core *.py *.md *.json
recursive-include agent_worker *.py *.md *.json
recursive-include agent_runtime *.py
recursive-include reference_runtime *.py
recursive-include docs *.md
recursive-include config *.json
recursive-include schemas *.json *.md
recursive-include examples *
recursive-include scripts *.py *.sh agentctl
recursive-include tests *.py
recursive-include .github *.md *.yml *.json CODEOWNERS
include validation/README.md
prune .git
prune .demo
prune .runtime
prune .state
prune .publication
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod] .env .env.* *.pem *.key *.p12 *.pfx
