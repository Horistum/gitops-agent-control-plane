#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${PYTHON:-python3}"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

usage() {
  cat <<'EOF'
Usage: scripts/agentctl <command> [args...]

Standalone reference commands:
  demo [scenario|all]    Run the executable showcase and preserve evidence
  conformance            Run all behavioral conformance scenarios
  validate               Run repository validation plus conformance
  bootstrap <command>    Linux prerequisite check/prepare/self-test
  diagnose               Read-only local diagnostics
  cleanup                Remove local demo artifacts
  help                   Show this help

Scenarios:
  happy-path
  forbidden-path
  test-failure
  human-gate
  crash-recovery

No GitHub account, model provider, token, container engine, or private runtime is
required for demo/conformance/validate.
EOF
}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }

run_demo() {
  local scenario="${1:-happy-path}"
  if [[ "$scenario" == "all" ]]; then
    exec "$PYTHON" -m reference_runtime.conformance \
      --repository-root "$ROOT" \
      --output "$ROOT/.demo/runs"
  fi
  exec "$PYTHON" -m reference_runtime.engine \
    --repository-root "$ROOT" \
    --scenario "$scenario" \
    --output "$ROOT/.demo/runs"
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    help|-h|--help) usage ;;
    demo) run_demo "$@" ;;
    conformance)
      exec "$PYTHON" -m reference_runtime.conformance --repository-root "$ROOT" "$@"
      ;;
    validate)
      "$PYTHON" "$ROOT/scripts/validate_reference.py"
      "$PYTHON" -m unittest discover -s "$ROOT/tests" -v
      exec "$PYTHON" -m reference_runtime.conformance --repository-root "$ROOT"
      ;;
    bootstrap) exec bash "$ROOT/scripts/bootstrap-linux.sh" "$@" ;;
    diagnose) exec bash "$ROOT/scripts/diagnose-linux.sh" "$@" ;;
    cleanup) exec bash "$ROOT/scripts/cleanup-linux.sh" "$@" ;;
    self-test)
      bash -n "$ROOT/scripts/agentctl"
      bash "$ROOT/scripts/bootstrap-linux.sh" self-test
      "$PYTHON" "$ROOT/scripts/validate_reference.py" --fast
      printf 'agentctl self-test: ok\n'
      ;;
    *) die "unknown command: $command (run ./scripts/agentctl help)" ;;
  esac
}

main "$@"
