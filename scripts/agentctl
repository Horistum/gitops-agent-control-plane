#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${PYTHON:-python3}"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

usage() {
  cat <<'EOF'
Usage: scripts/agentctl <command> [args...]

Standalone reference commands:
  demo [scenario|all]    Run showcase scenarios and preserve evidence
  conformance            Run all behavioral conformance scenarios
  validate               Run repository validation, unit tests, and conformance
  self-test              Fast shell/static self-test
  bootstrap <command>    Linux prerequisite check/prepare/self-test
  diagnose               Read-only local diagnostics
  cleanup                Remove local demo artifacts
  help                   Show this help

No GitHub account, model provider, token, container engine, or private runtime is
required. The local executor is for trusted deterministic fixtures only; it is not
a security sandbox for model-generated code.
EOF
}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }
py() { "$PYTHON" -S "$@"; }

run_demo() {
  local scenario="${1:-happy-path}"
  if [[ "$scenario" == "all" ]]; then
    exec "$PYTHON" -S -m reference_runtime.conformance --repository-root "$ROOT" --output "$ROOT/.demo/runs"
  fi
  exec "$PYTHON" -S -m reference_runtime.engine --repository-root "$ROOT" --scenario "$scenario" --output "$ROOT/.demo/runs"
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    help|-h|--help) usage ;;
    demo) run_demo "$@" ;;
    conformance) exec "$PYTHON" -S -m reference_runtime.conformance --repository-root "$ROOT" "$@" ;;
    validate)
      py "$ROOT/scripts/validate_reference.py"
      py -m unittest discover -s "$ROOT/tests" -v
      exec "$PYTHON" -S -m reference_runtime.conformance --repository-root "$ROOT"
      ;;
    self-test)
      bash -n "$ROOT/scripts/agentctl"
      bash "$ROOT/scripts/bootstrap-linux.sh" self-test
      py "$ROOT/scripts/validate_reference.py" --fast
      printf 'agentctl self-test: ok\n'
      ;;
    bootstrap) exec bash "$ROOT/scripts/bootstrap-linux.sh" "$@" ;;
    diagnose) exec bash "$ROOT/scripts/diagnose-linux.sh" "$@" ;;
    cleanup) exec bash "$ROOT/scripts/cleanup-linux.sh" "$@" ;;
    *) die "unknown command: $command (run ./scripts/agentctl help)" ;;
  esac
}

main "$@"
