{
  "schema": 6,
  "reference_contract": "gitops-agent-control-plane/v7",
  "contracts": {
    "core": "autonomous-control-plane/v1",
    "verification": "property-probe/v6",
    "runtime": "standalone-local/v2"
  },
  "executor_mode": "trusted-fixture-local",
  "developer_allowed_paths": [
    "src/**"
  ],
  "tester_allowed_paths": [
    "tests/test_acceptance_*.py"
  ],
  "authority_paths": [
    ".agent-control/**",
    "ci/**",
    ".github/**"
  ],
  "protected_test_paths": [
    "tests/test_service.py"
  ],
  "risk_rules": [
    {
      "risk": "high",
      "paths": [
        "src/**/security/**"
      ]
    },
    {
      "risk": "medium",
      "paths": [
        "src/**/contract/**"
      ]
    }
  ],
  "minimum_baseline_tests": 3,
  "max_changed_files": 4,
  "max_patch_bytes": 12000,
  "test_timeout_seconds": 10,
  "default_risk": "low",
  "human_gate_at": "high",
  "max_cycles": 6,
  "max_attempts_per_item": 3
}
